# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Integration with Football API (API-Football / API-Sports)
# Base URL: Use https://v3.football.api-sports.io (API-Sports) or RapidAPI endpoint
FOOTBALL_API_URL=https://v3.football.api-sports.io
# Your Secret API Key
FOOTBALL_API_KEY=your_api_key_here
# Authentication Header: x-apisports-key (API-Sports direct) or x-rapidapi-key (RapidAPI)
FOOTBALL_API_HEADER=x-apisports-key

# Default tournament settings (used by sync jobs when no overrides are passed)
# 1 = World Cup (Copa do Mundo)
FOOTBALL_API_DEFAULT_COMPETITION_ID=1
FOOTBALL_API_DEFAULT_SEASON=2022
